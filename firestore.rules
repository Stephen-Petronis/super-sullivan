rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Super Sullivan high scores: one collection per game (ss_g0 .. ss_g3).
    // Anyone can read the boards and add a score; nobody can edit or delete.
    match /{board}/{doc} {
      allow read: if board.matches('ss_g[0-3]');
      allow create: if board.matches('ss_g[0-3]')
        && request.resource.data.keys().hasOnly(['n', 'k', 'd', 't'])
        && request.resource.data.n is string && request.resource.data.n.size() == 3
        && request.resource.data.k is number
        && request.resource.data.d is string && request.resource.data.d.size() <= 12
        && request.resource.data.t is timestamp;
      allow update, delete: if false;
    }
  }
}
